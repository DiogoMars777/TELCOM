@startuml cu01_secuencia_iniciar_cerrar_sesion
autonumber
skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6

skinparam sequence {
    ArrowColor black
    ActorBorderColor #A80036
    ActorBackgroundColor #FEFECE
    LifeLineBorderColor #8A4B38
    LifeLineBackgroundColor #FFF2E6
    ParticipantBorderColor #8A4B38
    ParticipantBackgroundColor #FFF2E6
    BoxBorderColor #A80036
    BoxBackgroundColor #FAFAFA
    GroupBackgroundColor #F8F9FA
    GroupBorderColor #8A4B38
    DividerBackgroundColor #EFEFEF
    DividerBorderColor #8A4B38
}

actor "Usuario / Administrador" as UsuarioActor
boundary UI_Sesion
control AuthController
entity Usuario
entity UserSession

== Flujo 1: Iniciar Sesión (Login) ==

UsuarioActor -> UI_Sesion: 1: iniciarSesion(email, password)
activate UI_Sesion

UI_Sesion -> AuthController: 1.1: login(Request)
activate AuthController

AuthController -> AuthController: validate([email, password])

AuthController -> Usuario: 1.2: where('email', email)->first()
activate Usuario
Usuario --> AuthController: $user / null
deactivate Usuario

alt Credenciales incorrectas o usuario no encontrado
    AuthController --> UI_Sesion: error('Credenciales incorrectas.', 401)
    UI_Sesion --> UsuarioActor: mostrarError()
else Cuenta desactivada (!user->activo)
    AuthController --> UI_Sesion: error('Tu cuenta está desactivada.', 403)
    UI_Sesion --> UsuarioActor: mostrarAlertaInactivo()
else Credenciales válidas y cuenta activa
    AuthController -> Usuario: createToken('auth_token')->plainTextToken
    activate Usuario
    Usuario --> AuthController: $token
    deactivate Usuario

    AuthController -> UserSession: 1.3: create(['user_id' => id, 'ip_address' => ip, 'login_at' => now(), 'is_active' => true])
    activate UserSession
    UserSession --> AuthController: sesionRegistrada
    deactivate UserSession

    AuthController --> UI_Sesion: success(['user' => presentUser, 'token' => token])
    deactivate AuthController

    UI_Sesion -> UI_Sesion: guardarTokenLocalStorage()
    UI_Sesion --> UsuarioActor: redireccionarDashboard()
    deactivate UI_Sesion
end

== Flujo 2: Cerrar Sesión (Logout) ==

UsuarioActor -> UI_Sesion: 2: cerrarSesion()
activate UI_Sesion

UI_Sesion -> AuthController: 2.1: logout(Request)
activate AuthController

AuthController -> Usuario: currentAccessToken()->delete()
activate Usuario
Usuario --> AuthController: tokenRevocado
deactivate Usuario

AuthController -> UserSession: 2.2: where('user_id', id)->where('is_active', true)->update(['logout_at' => now(), 'is_active' => false])
activate UserSession
UserSession --> AuthController: sesionCerrada
deactivate UserSession

AuthController --> UI_Sesion: success(null, 'Sesión finalizada exitosamente.')
deactivate AuthController

UI_Sesion -> UI_Sesion: limpiarLocalStorage()
UI_Sesion --> UsuarioActor: redireccionarLogin()
deactivate UI_Sesion

== Flujo 3: Recuperar Contraseña (Olvido de contraseña) ==

UsuarioActor -> UI_Sesion: 3: solicitarRecuperacion(email)
activate UI_Sesion

UI_Sesion -> AuthController: 3.1: forgotPassword(Request)
activate AuthController

AuthController -> AuthController: validate([email])

AuthController -> Usuario: 3.2: where('email', email)->exists()
activate Usuario
Usuario --> AuthController: bool $exists
deactivate Usuario

AuthController --> UI_Sesion: success('Si el correo existe, recibirás un código de verificación.')
deactivate AuthController

UI_Sesion --> UsuarioActor: mostrarFormularioCodigo()

UsuarioActor -> UI_Sesion: 4: restablecerPassword(email, codigo, nuevoPassword, confirmacion)

UI_Sesion -> AuthController: 4.1: resetPassword(Request)
activate AuthController

AuthController -> AuthController: validate([email, code, new_password, new_password_confirmation])

AuthController -> Usuario: 4.2: where('email', email)->first()
activate Usuario
Usuario --> AuthController: $user
deactivate Usuario

alt Verificación fallida o código inválido
    AuthController --> UI_Sesion: error('Código inválido o vencido.', 422)
    UI_Sesion --> UsuarioActor: mostrarErrorValidacion()
else Verificación exitosa
    AuthController -> Usuario: 4.3: update(['password' => Hash::make(new_password)])
    activate Usuario
    Usuario --> AuthController: passwordActualizado
    deactivate Usuario

    AuthController -> Usuario: 4.4: tokens()->delete()
    activate Usuario
    Usuario --> AuthController: tokensRevocados
    deactivate Usuario

    AuthController --> UI_Sesion: success(null, 'Contraseña restablecida correctamente.')
    deactivate AuthController

    UI_Sesion --> UsuarioActor: notificarExitoRedireccionarLogin()
    deactivate UI_Sesion
end
@enduml


